{
    "manifest_version": 3,
    "name": "BeesWax",
    "version": "1.02",
    "permissions": ["activeTab", "tabs", "storage"],
    
    "host_permissions": ["http://localhost/*", "http://localhost:5000/*"],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": "icon.png"
    }
  }

  